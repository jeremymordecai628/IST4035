<%- include('partials/header') %>

<% if (success) { %>
  <div class="container"><div class="alert alert-success" role="status"><%= success %></div></div>
<% } %>

<section class="hero">
  <div class="container hero-inner">
    <p class="hero-eyebrow">USIU-Africa campus</p>
    <h1>Lost something? Found something?</h1>
    <p class="hero-lead">Report it, search it, get it back. One place for every lost and found item on campus.</p>
    <div class="hero-actions">
      <a class="btn btn-gold" href="/report/lost">I lost an item</a>
      <a class="btn btn-outline-light" href="/report/found">I found an item</a>
    </div>
    <form class="hero-search" action="/items" method="GET" role="search">
      <label class="visually-hidden" for="hero-q">Search items</label>
      <input id="hero-q" type="search" name="q" placeholder="Search e.g. black backpack, ID card, keys" maxlength="100">
      <button class="btn btn-gold" type="submit">Search</button>
    </form>
  </div>
</section>

<section class="container stats">
  <div class="stat"><span class="stat-number"><%= stats.lost %></span><span class="stat-label">Items reported lost</span></div>
  <div class="stat"><span class="stat-number"><%= stats.found %></span><span class="stat-label">Items found</span></div>
  <div class="stat"><span class="stat-number"><%= stats.returned %></span><span class="stat-label">Returned to owners</span></div>
</section>

<section class="container section">
  <div class="section-head">
    <h2>Recently reported</h2>
    <a href="/items">View all items &rarr;</a>
  </div>
  <% if (recent.length === 0) { %>
    <div class="empty-state">
      <h3>Nothing reported yet</h3>
      <p>Be the first to report a lost or found item.</p>
    </div>
  <% } else { %>
    <div class="card-grid">
      <% recent.forEach(function (item) { %>
        <article class="item-card">
          <a class="item-media item-media-<%= item.type %>" href="/items/<%= encodeURIComponent(item.id) %>" tabindex="-1" aria-hidden="true">
            <% if (item.imagePath) { %>
              <img src="<%= item.imagePath %>" alt="" loading="lazy">
            <% } else if (item.type === 'found') { %>
              <svg class="placeholder-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l3 3 5-6"></path></svg>
            <% } else { %>
              <svg class="placeholder-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6"></circle><path d="M15 15l5.5 5.5"></path></svg>
            <% } %>
            <span class="badge badge-<%= item.type %> item-type"><%= item.typeLabel %></span>
          </a>

          <div class="item-body">
            <div class="item-top">
              <span class="badge <%= item.statusClass %>"><%= item.status %></span>
              <span class="item-date"><%= item.displayDate %></span>
            </div>
            <h3 class="item-title"><a href="/items/<%= encodeURIComponent(item.id) %>"><%= item.itemName %></a></h3>
            <p class="item-meta"><%= item.category %> &middot; <%= item.location %></p>
            <% if (item.shortDescription) { %>
              <p class="item-desc"><%= item.shortDescription %></p>
            <% } %>
            <a class="item-link" href="/items/<%= encodeURIComponent(item.id) %>">View details <span aria-hidden="true">&rarr;</span></a>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="container section">
  <h2>How it works</h2>
  <ol class="steps">
    <li><strong>Report</strong><span>Fill in a short form for the item you lost or found.</span></li>
    <li><strong>Search</strong><span>Browse or filter by category, place and date.</span></li>
    <li><strong>Claim</strong><span>Spot your item? Send a claim with details only you would know.</span></li>
    <li><strong>Collect</strong><span>The administrator verifies you and arranges pickup.</span></li>
  </ol>
</section>

<%- include('partials/footer') %>
