<%
  // Top of every page. Each route must send `title` and `active` to res.render().
  // active is one of: 'home', 'browse', 'lost', 'found', 'admin' (it highlights the menu link)
  const siteName = 'USIU-Africa Lost & Found';
  let pageTitle = '';
  if (typeof title !== 'undefined' && title) {
    pageTitle = title + ' - ';
  }
  let nav = '';
  if (typeof active !== 'undefined') {
    nav = active;
  }
  let admin = false;
  if (typeof isAdmin !== 'undefined' && isAdmin) {
    admin = true;
  }
%><!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %><%= siteName %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
  <div class="container nav-bar">
    <a class="brand" href="/" aria-label="<%= siteName %> home">
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" rx="8"></rect>
        <circle cx="14.5" cy="14.5" r="6" fill="none" stroke="currentColor" stroke-width="2.4"></circle>
        <path d="M19.2 19.2l6 6" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"></path>
      </svg>
      <span class="brand-text"><strong>USIU-Africa</strong> Lost &amp; Found</span>
    </a>

    <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav">
      <span></span><span></span><span></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <a href="/" class="<%= nav === 'home' ? 'active' : '' %>">Home</a>
      <a href="/items" class="<%= nav === 'browse' ? 'active' : '' %>">Browse Items</a>
      <a href="/report/lost" class="<%= nav === 'lost' ? 'active' : '' %>">Report Lost</a>
      <a href="/report/found" class="<%= nav === 'found' ? 'active' : '' %>">Report Found</a>
      <% if (admin) { %>
        <a href="/admin/dashboard" class="<%= nav === 'admin' ? 'active' : '' %>">Dashboard</a>
        <form class="nav-logout" action="/admin/logout" method="POST">
          <button class="nav-cta" type="submit">Log out</button>
        </form>
      <% } else { %>
        <a href="/admin/login" class="nav-cta <%= nav === 'admin' ? 'active' : '' %>">Admin Login</a>
      <% } %>
    </nav>
  </div>
</header>

<main id="main" class="main">
