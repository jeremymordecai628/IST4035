<script>
// Open and close the menu on small screens
const menuButton = document.querySelector('.nav-toggle');
const menu = document.getElementById('site-nav');

if (menuButton && menu) {
  menuButton.addEventListener('click', function () {
    menu.classList.toggle('open');
  });
}

// Hide the green success message after 6 seconds
const banners = document.querySelectorAll('.alert-success');
for (let i = 0; i < banners.length; i++) {
  setTimeout(function () {
    banners[i].style.display = 'none';
  }, 6000);
}

// For forms with data-confirm="..." ask the user before sending (used for Remove / Reject)
const confirmForms = document.querySelectorAll('form[data-confirm]');
for (let i = 0; i < confirmForms.length; i++) {
  confirmForms[i].addEventListener('submit', function (event) {
    if (!confirm(confirmForms[i].getAttribute('data-confirm'))) {
      event.preventDefault();
    }
  });
}
</script>
