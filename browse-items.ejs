<%- include('partials/header') %>

<div class="container">
  <div class="page-head">
    <h1>Browse items</h1>
    <p>Showing <%= items.length %> of <%= total %> reports.</p>
  </div>

  <% if (success) { %>
    <div class="alert alert-success" role="status"><%= success %></div>
  <% } %>

  <form class="filter-bar" action="/items" method="GET" role="search">
    <div class="field field-grow">
      <label for="q">Search</label>
      <input id="q" type="search" name="q" value="<%= filters.q %>" placeholder="Name, description or category" maxlength="100">
    </div>
    <div class="field">
      <label for="type">Type</label>
      <select id="type" name="type">
        <option value="">Lost and found</option>
        <option value="lost" <%= filters.type === 'lost' ? 'selected' : '' %>>Lost</option>
        <option value="found" <%= filters.type === 'found' ? 'selected' : '' %>>Found</option>
      </select>
    </div>
    <div class="field">
      <label for="category">Category</label>
      <select id="category" name="category">
        <option value="">All categories</option>
        <% categories.forEach(function (c) { %>
          <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
    </div>
    <div class="field">
      <label for="location">Location</label>
      <select id="location" name="location">
        <option value="">All locations</option>
        <% locations.forEach(function (l) { %>
          <option value="<%= l %>" <%= filters.location === l ? 'selected' : '' %>><%= l %></option>
        <% }) %>
      </select>
    </div>
    <div class="filter-actions">
      <button class="btn btn-primary" type="submit">Search</button>
      <% if (hasFilters) { %><a class="btn btn-light" href="/items">Clear</a><% } %>
    </div>
  </form>

  <% if (items.length === 0) { %>
    <div class="empty-state">
      <h3>No items match your search</h3>
      <p>Try fewer words or clear the filters. Or <a href="/report/lost">report your lost item</a> so a finder can match it.</p>
    </div>
  <% } else { %>
    <div class="card-grid">
      <% items.forEach(function (item) { %>
        <article class="item-card">
          <a class="item-media item-media-<%= item.type %>" href="/items/<%= encodeURIComponent(item.id) %>" tabindex="-1" aria-hidden="true">
            <% if (item.imagePath) { %>
              <img src="<%= item.imagePath %>" alt="" loading="lazy">
            <% } else if (item.type === 'found') { %>
              <svg class="placeholder-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l3 3 5-6"></path></svg>
            <% } else { %>
              <svg class="placeholder-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6"></circle><path d="M15 15l5.5 5.5"></path></svg>
            <% } %>
            <span class="badge badge-<%= item.type %> item-type"><%= item.typeLabel %></span>
          </a>

          <div class="item-body">
            <div class="item-top">
              <span class="badge <%= item.statusClass %>"><%= item.status %></span>
              <span class="item-date"><%= item.displayDate %></span>
            </div>
            <h3 class="item-title"><a href="/items/<%= encodeURIComponent(item.id) %>"><%= item.itemName %></a></h3>
            <p class="item-meta"><%= item.category %> &middot; <%= item.location %></p>
            <% if (item.shortDescription) { %>
              <p class="item-desc"><%= item.shortDescription %></p>
            <% } %>
            <a class="item-link" href="/items/<%= encodeURIComponent(item.id) %>">View details <span aria-hidden="true">&rarr;</span></a>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
